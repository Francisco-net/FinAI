{
  "name": "FinAI",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "postCreateCommand": "pip install --user uv && uv sync --all-extras && (test -f .env || cp .env.example .env) && (test -d .git && uv run pre-commit install || true)",
  "forwardPorts": [8000, 8501],
  "portsAttributes": {
    "8000": { "label": "API (FastAPI)" },
    "8501": { "label": "Interface web (Streamlit)" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "ms-toolsai.jupyter",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
