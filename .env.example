# Copie para .env e preencha:  cp .env.example .env

# Chave da API da Anthropic (crie em https://platform.claude.com)
ANTHROPIC_API_KEY=

# ---- Agente ----
# Modelo (padrão: Claude Opus 5.5)
FINAI_MODEL=claude-opus-5-5
# Profundidade de raciocínio: low | medium | high | xhigh | max (mais alto = melhor e mais caro/lento)
FINAI_EFFORT=medium
FINAI_MAX_TOKENS=32000
# summarized = mostra resumo do raciocínio na interface; omitted = esconde
FINAI_THINKING_DISPLAY=summarized
# Refaz no servidor, em outro modelo, pedidos recusados pelos filtros de segurança.
# Desative (false) se usar Bedrock/Vertex/Foundry ou modelos anteriores à família 5.x.
FINAI_REFUSAL_FALLBACK=true
FINAI_MAX_TOOL_ITERATIONS=12

# ---- Dados de mercado ----
# true = não acessa a internet (usa valores de referência do assumptions.yaml)
FINAI_OFFLINE=false
FINAI_BCB_TIMEOUT_SECONDS=8
FINAI_MARKET_CACHE_TTL_SECONDS=3600
